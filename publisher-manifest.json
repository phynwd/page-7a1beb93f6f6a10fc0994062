olumns:88px 1fr;gap:14px;font-size:14px;padding-bottom:13px;border-bottom:1px dashed rgba(255,255,255,.13)}\n.panel .row:last-child{border-bottom:0;padding-bottom:0}\n.panel dt{color:#8ea3bb}\n.panel dd{margin:0;color:#e7eff7}\n.panel .note{margin:18px 0 0;font-size:12.5px;line-height:1.7;color:#8ba0b7}\n\n/* 通用区块 */\nsection{padding:72px 0}\n.sec-head{margin-bottom:38px;max-width:62ch}\n.sec-kicker{font-size:12px;letter-spacing:.3em;color:#9a6a1c;margin:0 0 14px}\nh2.sec-title{font-size:clamp(24px,3.4vw,32px);margin:0 0 14px;line-height:1.3;font-weight:750;letter-spacing:.01em}\n.sec-desc{margin:0;color:var(--muted);font-size:15px}\n\n/* 使用说明：留白分隔，无边框 */\n#how{border-bottom:1px solid #dcd6ca}\n.steps{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:44px 56px}\n.step{padding:0}\n.step .no{font-size:12px;letter-spacing:.24em;color:#9a6a1c;display:block;margin-bottom:8px}\n.step h3{font-size:19px;margin:0 0 10px;font-weight:700}\n.step p{margin:0;color:var(--muted);font-size:15px}\n.step p + p{margin-top:8px}\n\n/* 套餐：阶梯递进 */\n#plans{background:#fff}\n.stairs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;align-items:end;border-top:1px solid #e2ddd2}\n.stair{padding:34px 30px 38px;border-right:1px solid #e2ddd2;display:flex;flex-direction:column}\n.stair:last-child{border-right:0}\n.stair.lift{padding-top:64px;background:var(--deep);color:#e9f0f7}\n.stair.mid{padding-top:46px}\n.stair-top{font-size:12px;letter-spacing:.24em;color:#9a6a1c;margin:0 0 10px}\n.stair.lift .stair-top{color:var(--amber)}\n.stair h3{font-size:22px;margin:0 0 6px;font-weight:750}\n.stair .price{font-size:30px;font-weight:800;letter-spacing:.01em;margin:14px 0 2px}\n.stair .price small{font-size:13px;font-weight:500;color:var(--muted);margin-left:4px}\n.stair.lift .price small{color:#9db2c8}\n.stair .annual{font-size:13px;color:var(--muted);margin:0 0 20px}\n.stair.lift .annual{color:#9db2c8}\n.stair ul{list-style:none;margin:0 0 22px;padding:0;display:grid;gap:11px;font-size:14.5px}\n.stair li{padding-left:16px;position:relative;color:#2d3c4d}\n.stair.lift li{color:#cfdcea}\n.stair li::before{content:\"\";position:absolute;left:0;top:.66em;width:6px;height:6px;background:var(--amber)}\n.stair .tag{display:inline-block;font-size:11px;letter-spacing:.18em;border:1px solid var(--amber);color:var(--amber);padding:3px 9px;margin-bottom:16px;align-self:flex-start}\n.stair .cta{margin-top:auto;font-size:13.5px;letter-spacing:.06em;text-decoration:none;border-bottom:1px solid currentColor;align-self:flex-start;padding-bottom:2px}\n.stair.lift .cta{color:var(--amber-soft)}\n.stair:not(.lift) .cta{color:#2b4258}\n.plans-note{margin:28px 0 0;font-size:13px;color:var(--muted);line-height:1.8}\n\n/* 客户端 */\n#clients{background:var(--paper)}\n.client-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px 48px}\n.client h3{font-size:17px;margin:0 0 8px;font-weight:700}\n.client p{margin:0;font-size:14.5px;color:var(--muted)}\n.client .meta{display:block;font-size:12px;letter-spacing:.2em;color:#9a6a1c;margin-bottom:8px}\n\n/* FAQ 分组 */\n#faq{background:#fff;border-top:1px solid #e2ddd2}\n.faq-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:52px 64px}\n.group h3{font-size:13px;letter-spacing:.24em;color:#9a6a1c;margin:0 0 20px;font-weight:600}\n.qa{margin:0 0 24px;padding-bottom:22px;border-bottom:1px solid #eee9de}\n.qa:last-child{border-bottom:0;padding-bottom:0;margin-bottom:0}\n.qa h4{font-size:16px;margin:0 0 8px;font-weight:700;line-height:1.55}\n.qa p{margin:0;font-size:14.5px;color:var(--muted)}\n\n/* 页脚 */\nfooter{background:var(--deep);color:#93a7bd;padding:44px 0 52px;font-size:13.5px}\nfooter .wrap{display:flex;justify-content:space-between;gap:26px;flex-wrap:wrap}\nfooter strong{color:#fff;letter-spacing:.2em;font-weight:700}\nfooter p{margin:8px 0 0;max-width:46ch;line-height:1.8}\nfooter .links{display:flex;gap:20px;flex-wrap:wrap;align-items:flex-start}\nfooter a{text-decoration:none;color:#c7d4e2;border-bottom:1px solid transparent}\nfooter a:hover{color:var(--amber);border-bottom-color:var(--amber)}\n\n@media (max-width:900px){\n  .hero-grid{grid-template-columns:1fr;gap:38px}\n  .stairs{grid-template-columns:1fr;border-top:0}\n  .stair{border-right:0;border-top:1px solid #e2ddd2;padding:30px 22px 34px}\n  .stair.lift,.stair.mid{padding-top:30px}\n  .client-grid{grid-template-columns:1fr;gap:30px}\n  .faq-groups{grid-template-columns:1fr;gap:38px}\n  .steps{grid-template-columns:1fr;gap:32px}\n  section{padding:56px 0}\n}\n@media (max-width:520px){\n  .topnav{gap:14px;font-size:12.5px}\n  .panel{padding:20px}\n  .panel .row{grid-template-columns:74px 1fr;font-size:13px}\n  h1{font-size:36px}\n}\n</style><div class=\"topbar\">\n  <div class=\"wrap\">\n    <div class=\"brandline\"><strong>飞兔</strong><span>订阅说明</span></div>\n    <nav class=\"topnav\" aria-label=\"页面目录\">\n      <a href=\"#how\">使用说明</a>\n      <a href=\"#plans\">订阅套餐</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</div>\n\n<main>\n\n  <section class=\"hero\">\n    <div class=\"wrap hero-grid\">\n      <div>\n        <p class=\"eyebrow\">FLYING RABBIT · 产品说明</p>\n        <h1>飞兔：把订阅这件事<em>讲清楚</em></h1>\n        <p class=\"hero-lead\">这份页面按说明书的方式组织：先说清楚有哪些档位、每档包含什么、适合什么使用情形，再说明怎么开始以及哪里容易卡住。</p>\n        <p class=\"hero-lead secondary\">我们不使用模糊的形容词来描述服务。下面出现的每一项，都是可以被核对的条目。价格、流量与设备数量以本页列出的内容为准。</p>\n      </div>\n      <aside class=\"panel\" aria-label=\"页面要点速览\">\n        <h2>速览</h2>\n        <dl>\n          <div class=\"row\"><dt>档位数量</dt><dd>三档，按月或按年计</dd></div>\n          <div class=\"row\"><dt>流量区间</dt><dd>每月 100GB 至 1000GB</dd></div>\n          <div class=\"row\"><dt>设备数量</dt><dd>3 台至 20 台同时在线</dd></div>\n          <div class=\"row\"><dt>计费方式</dt><dd>月付与年付两种，年付单价更低</dd></div>\n          <div class=\"row\"><dt>升级路径</dt><dd>由低档向高档逐级递增</dd></div>\n        </dl>\n        <p class=\"note\">本页不提供在线付款入口，也不提供下载地址。若你正在核对某一项细节，请以本页文字为准，避免依赖第三方转述。</p>\n      </aside>\n    </div>\n  </section>\n\n  <section id=\"how\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"sec-kicker\">使用说明</p>\n        <h2 class=\"sec-title\">从选择到开始，共四步</h2>\n        <p class=\"sec-desc\">以下步骤按顺序执行即可。如果某一步与你手上的情况不一致，先解决该步，再继续下一步，通常比反复重来更快。</p>\n      </div>\n      <div class=\"steps\">\n        <article class=\"step\">\n          <span class=\"no\">01</span>\n          <h3>先数设备，再看流量</h3>\n          <p>把你需要同时联网的设备列出来：手机、平板、电脑各算一台。这个数量决定你最低该选哪一档，因为同时在线设备的数量是有上限的。</p>\n          <p>流量则按你每天大概的在线时长估算。两者取更严格的那一项。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"no\">02</span>\n          <h3>确定计费周期</h3>\n          <p>三档都提供月付与年付。年付的年总价明显低于十二个月月付之和，但需要一次性支付。若你不确定会持续使用多久，从月付开始更稳妥。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"no\">03</span>\n          <h3>按平台准备客户端</h3>\n          <p>不同平台的配置方式不同，先在对应平台上完成准备，再回到账号里读取需要的配置信息。准备阶段不必急于填入任何内容。</p>\n          <p>若某个平台你没有在用，跳过它即可，不影响其余设备。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"no\">04</span>\n          <h3>逐台加入并核对</h3>\n          <p>建议先只加入一台设备，确认一切正常后，再把其余设备依次加入。这样如果出现问题，能立刻定位到是哪一台、哪一步。</p>\n          <p>全部加入后，回头核对一次同时在线设备数量是否超过所选档位的上限。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"sec-kicker\">订阅套餐</p>\n        <h2 class=\"sec-title\">三档递进：从基础版到团队版</h2>\n        <p class=\"sec-desc\">三档之间的差别集中在三处：每月流量、同时在线设备数量、以及线路与支持的等级。价格随之上移，没有任何一档是隐藏选项。</p>\n      </div>\n\n      <div class=\"stairs\">\n        <article class=\"stair\">\n          <p class=\"stair-top\">第一档</p>\n          <h3>基础版</h3>\n          <p class=\"price\">¥15<small>/ 月</small></p>\n          <p class=\"annual\">按年付仅需 ¥150 / 年</p>\n          <ul>\n            <li>每月 100GB 流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <a class=\"cta\" href=\"#faq\">查看相关问题</a>\n        </article>\n\n        <article class=\"stair mid\">\n          <p class=\"stair-top\">第二档</p>\n          <h3>旗舰版</h3>\n          <p class=\"price\">¥35<small>/ 月</small></p>\n          <p class=\"annual\">按年付仅需 ¥350 / 年</p>\n          <ul>\n            <li>每月 300GB 流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n          <a class=\"cta\" href=\"#faq\">查看相关问题</a>\n        </article>\n\n        <article class=\"stair lift\">\n          <span class=\"tag\">推荐</span>\n          <p class=\"stair-top\">第三档</p>\n          <h3>团队版</h3>\n          <p class=\"price\">¥85<small>/ 月</small></p>\n          <p class=\"annual\">按年付仅需 ¥850 / 年</p>\n          <ul>\n            <li>每月 1000GB 流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <a class=\"cta\" href=\"#faq\">查看相关问题</a>\n        </article>\n      </div>\n\n      <p class=\"plans-note\">说明：上表列出的流量按月计算；同时在线设备数量为上限，不等于可以任意时刻全部活跃。年付价格对应一次性支付一年，折算后低于同档月付十二个月之和。本页不展示付款流程，也不承诺任何未在此列出的权益。</p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"sec-kicker\">客户端</p>\n        <h2 class=\"sec-title\">按平台准备，不必一次全部装好</h2>\n        <p class=\"sec-desc\">下面按平台类型说明准备工作。这里不提供具体下载地址，请通过你所在平台的正规渠道获取客户端。</p>\n      </div>\n      <div class=\"client-grid\">\n        <article class=\"client\">\n          <span class=\"meta\">桌面端</span>\n          <h3>Windows / macOS</h3>\n          <p>桌面端适合长时间在线与多窗口使用。安装后先在系统设置中确认网络相关权限已放行，再导入配置。若同时使用多台桌面设备，留意它们会一起占用设备名额。</p>\n        </article>\n        <article class=\"client\">\n          <span class=\"meta\">移动端</span>\n          <h3>iOS / Android</h3>\n          <p>移动端通常在首次启用时请求网络权限，请在弹窗出现时允许，否则会出现已连接但无法访问的情况。手机与平板各自计为一台设备。</p>\n        </article>\n        <article class=\"client\">\n          <span class=\"meta\">路由器与其他</span>\n          <h3>路由器 / 其他终端</h3>\n          <p>在路由器上统一配置可以让接入该路由器的设备共享同一个出口，但这会把设备数量计算方式变得不直观。若你要这样做，建议先只在一个小型环境中测试。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"sec-kicker\">常见问题</p>\n        <h2 class=\"sec-title\">按主题分组的问答</h2>\n        <p class=\"sec-desc\">下面的问题按主题归类：选择与计费、设备与流量、使用与排错。每条都给出可以直接执行的答案。</p>\n      </div>\n\n      <div class=\"faq-groups\">\n\n        <div class=\"group\">\n          <h3>一 · 选择与计费</h3>\n\n          <article class=\"qa\">\n            <h4>三档之间最关键的差别是什么？</h4>\n            <p>是每月流量与同时在线设备数量的组合。基础版 100GB / 3 台，旗舰版 300GB / 5 台，团队版 1000GB / 20 台。其余条目（流媒体解锁范围、线路等级、支持方式）随档位一同提升。</p>\n          </article>\n\n          <article class=\"qa\">\n            <h4>年付真的更划算吗？我该怎么判断？</h4>\n            <p>三档的年付都是同档月付的十倍，相当于用十个月的价格覆盖十二个月。判断标准很简单：如果你预计会连续使用超过十个月，年付合适；否则先月付，避免为用不到的时间付费。</p>\n          </article>\n\n          <article class=\"qa\">\n            <h4>可以先选低档，之后再换吗？</h4>\n            <p>档位是逐级递进的，低档向上调整比反过来更常见。建议做法是先按月付选择一档，观察一两个计费周期内实际用掉多少流量、同时在线几台设备，再决定是否上移。</p>\n          </article>\n\n          <article class=\"qa\">\n            <h4>团队版的「企业定制路由」是什么意思？</h4>\n            <p>它指的是在团队版中可以为特定的网络结构做路由层面的安排，而不是一项面向个人用户的普通功能。如果你并不清楚自己是否需要它，通常说明暂时不需要。</p>\n          </article>\n        </div>\n\n        <div class=\"group\">\n          <h3>二 · 设备与流量</h3>\n\n          <article class=\"qa\">\n            <h4>「同时在线」具体怎么算？</h4>\n            <p>指同一时刻处于在线状态的设备数量。手机与平板分别计算，不合并。若你在路由器上统一配置，接入该路由器的每台设备仍应计入，因此这种做法更容易触及上限。</p>\n          </article>\n\n          <article class=\"qa\">\n            <h4>流量用超了会怎样？</h4>\n            <p>本页只说明各档的每月流量额度，不描述额度用尽后的具体处理方式。稳妥的做法是在接近额度时检查自己的用量，并据此决定是否调整档位。</p>\n          </article>\n\n          <article class=\"qa\">\n            <h4>怎样才能少用一些流量？</h4>\n            <p>优先降低视频清晰度，这是最直接的一项。其次是避免让后台应用持续同步大文件，例如自动备份与云盘同步。把这两项控制住，月度用量通常会有明显变化。</p>\n          </article>\n\n          <article class=\"qa\">\n            <h4>换设备需要额外操作吗？</h4>\n            <p>不需要额外付费，但需要把旧设备退出，以保证在线数量不超过所选档位的上限。建议先退出再新增，避免两台设备短暂同时在线而占满名额。</p>\n          </article>\n        </div>\n\n        <div class=\"group\">\n          <h3>三 · 使用与排错</h3>\n\n          <article class=\"qa\">\n            <h4>配置好之后无法访问，先查什么？</h4>\n            <p>按顺序查三项：设备是否已获得网络权限；同时在线设备是否已达上限；配置信息是否完整复制（常见问题是首尾字符丢失）。三项都没有问题，再考虑更换线路。</p>\n          </article>\n\n          <article class=\"qa\">\n            <h4>为什么建议先只加一台设备？</h4>\n            <p>因为一次只引入一个变量，出问题时能立刻判断原因是配置、权限还是设备数量。一次把五台设备全部加进去，排查成本会成倍上升。</p>\n          </article>\n\n          <article class=\"qa\">\n            <h4>「优先工单支持」和「专属客户经理」差别在哪？</h4>\n            <p>前者是旗舰版中包含的工单响应优先级；后者是团队版中包含的一对一对接方式。两者都不表示可以即时解决任何技术问题，具体以实际沟通为准。</p>\n          </article>\n\n          <article class=\"qa\">\n            <h4>本页提到的流媒体解锁与游戏优化，能保证效果吗？</h4>\n            <p>不能保证。基础版标注为「基础流媒体解锁」，旗舰版与团队版标注为更完整的解锁范围；游戏加速相关条目描述的是线路层面的安排。实际表现会随所在地网络环境变化，本页不做效果承诺。</p>\n          </article>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div>\n      <strong>飞兔</strong>\n      <p>本页为订阅与使用说明。所列价格、流量与设备数量以页面文字为准；页面不提供付款入口与下载地址。</p>\n    </div>\n    <div class=\"links\">\n      <a href=\"#how\">使用说明</a>\n      <a href=\"#plans\">订阅套餐</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </div>\n  </div>\n</footer>",
